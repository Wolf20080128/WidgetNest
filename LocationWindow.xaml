<Window x:Class="WidgetNest.LocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择位置"
        Width="440" Height="474"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- 底部文字按钮 -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Divider}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Background="{DynamicResource MenuBackground}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16,14,16,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0">
                <TextBlock Text="选择位置"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" />

                <Button x:Name="CloseButton"
                        HorizontalAlignment="Right"
                        Width="24" Height="24"
                        Style="{StaticResource FlatButton}"
                        Padding="0"
                        ToolTip="关闭"
                        Click="CloseButton_Click">
                    <Path Data="M6,6 L18,18 M18,6 L6,18"
                          Stroke="{DynamicResource TextSecondary}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform"
                          Width="10" Height="10"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Button>
            </Grid>

            <TextBlock x:Name="CurrentText"
                       Grid.Row="1"
                       Text="当前：未选择位置"
                       FontSize="10.5"
                       Foreground="{DynamicResource TextTertiary}"
                       Margin="0,5,0,0"
                       TextTrimming="CharacterEllipsis" />

            <!-- 省 / 市 / 区县 三级联选 -->
            <Grid Grid.Row="2" Margin="0,11,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="省份" FontSize="10" Margin="8,0,0,6"
                           Foreground="{DynamicResource TextTertiary}" />

                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="城市" FontSize="10" Margin="8,0,0,6"
                           Foreground="{DynamicResource TextTertiary}" />

                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="区县" FontSize="10" Margin="8,0,0,6"
                           Foreground="{DynamicResource TextTertiary}" />

                <Border Grid.Row="1" Grid.Column="0"
                        Background="{DynamicResource SurfaceInset}"
                        CornerRadius="8" Margin="0,0,5,0"
                        ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,3">
                        <StackPanel x:Name="ProvincePanel" />
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="1" Grid.Column="1"
                        Background="{DynamicResource SurfaceInset}"
                        CornerRadius="8" Margin="0,0,5,0"
                        ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,3">
                        <StackPanel x:Name="CityPanel" />
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="1" Grid.Column="2"
                        Background="{DynamicResource SurfaceInset}"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,3">
                        <StackPanel x:Name="CountyPanel" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 底部 -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="ClearButton"
                        Content="清除位置"
                        Style="{StaticResource FlatButton}"
                        Foreground="{DynamicResource Danger}"
                        HorizontalAlignment="Left"
                        Click="ClearButton_Click" />

                <Button Grid.Column="2"
                        Content="取消"
                        Style="{StaticResource FlatButton}"
                        Click="CloseButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>

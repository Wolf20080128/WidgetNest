<UserControl x:Class="WidgetNest.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="370" d:DesignHeight="190">

    <!-- Background="Transparent" 不是为了好看：没有它空白区域不可命中，
         指针落在空格上时命中测试会穿透到外层 Border，滚轮事件就不会经过本页 -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ClipToBounds="True" Background="Transparent">

            <!-- 图标 / 小组件层：6 列 × 3 行，小组件通过 RowSpan/ColumnSpan 跨格 -->
            <Grid x:Name="ItemGrid" ClipToBounds="True" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
            </Grid>

            <!-- 空格提示 / 拖拽落点高亮层（不参与命中测试） -->
            <Grid x:Name="SlotLayer" IsHitTestVisible="False" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
            </Grid>

            <!-- 空态教程：仅在主页无任何内容时显示 -->
            <StackPanel x:Name="EmptyHint"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">

                <Border Padding="8,3"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource SurfaceSubtle}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <TextBlock Foreground="{DynamicResource TextSecondary}"
                               FontSize="11"
                               HorizontalAlignment="Center">
                        <Run Text="按" />
                        <Run x:Name="HotkeyRun" Text="Ctrl + Shift + A" FontWeight="SemiBold" />
                        <Run Text="唤出/隐藏面板" />
                    </TextBlock>
                </Border>

                <TextBlock Text="面板还是空的"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="12"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center" />

                <TextBlock Text="「更多 → 添加应用」拖入文件，或到小组件市场挑一个"
                           Foreground="{DynamicResource TextTertiary}"
                           FontSize="10"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <Canvas x:Name="DragLayer" IsHitTestVisible="False" />

            <!-- 拖拽到上下边缘时的翻页提示（默认透明，进入边缘停留区时淡入） -->
            <Border x:Name="TopEdgeHint"
                    Height="3"
                    Margin="10,2,10,0"
                    VerticalAlignment="Top"
                    CornerRadius="2"
                    Background="{DynamicResource TextSecondary}"
                    IsHitTestVisible="False"
                    Opacity="0" />

            <Border x:Name="BottomEdgeHint"
                    Height="3"
                    Margin="10,0,10,2"
                    VerticalAlignment="Bottom"
                    CornerRadius="2"
                    Background="{DynamicResource TextSecondary}"
                    IsHitTestVisible="False"
                    Opacity="0" />
        </Grid>

        <TextBlock x:Name="PageIndicator"
                   Grid.Row="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="10"
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="0,2,0,0"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>

<UserControl x:Class="WidgetNest.PreferencesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="True"
             PreviewKeyDown="Page_PreviewKeyDown"
             d:DesignWidth="370" d:DesignHeight="192">

    <UserControl.Resources>
        <!-- 设置行标题 -->
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- 设置行副标题 -->
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="Margin" Value="0,1,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- 分隔线 -->
        <Style x:Key="RowSeparator" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Divider}" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>

        <!-- 分段选择：一段一个单选项 -->
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceActive}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <!-- 放在最后：选中态压过悬停 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小号描边按钮 -->
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSubtle}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceActive}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 开关 -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="21" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                CornerRadius="10.5"
                                Background="{DynamicResource SurfaceInset}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1">
                            <Border x:Name="Knob"
                                    Width="15" Height="15"
                                    CornerRadius="7.5"
                                    HorizontalAlignment="Left"
                                    Margin="2,0,0,0"
                                    Background="{DynamicResource TextFaint}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                                <Setter TargetName="Knob" Property="Background" Value="{DynamicResource TextOnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 返回箭头 -->
        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSubtle}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 标题栏 ===== -->
        <Grid Grid.Row="0" Height="22">
            <Button Style="{StaticResource BackButton}"
                    HorizontalAlignment="Left"
                    ToolTip="返回主页"
                    Click="Back_Click">
                <Path Data="M15.41,7.41 L14,6 L8,12 L14,18 L15.41,16.59 L10.83,12 Z"
                      Fill="{DynamicResource TextSecondary}"
                      Stretch="Uniform"
                      Width="14" Height="14" />
            </Button>

            <TextBlock Text="偏好设置"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- ===== 设置项 =====
             面板高度是固定的，这里只有 192 的高度可用：
             22（标题）+ 4（顶距）+ 5×32（五行）+ 4×1（分隔线）= 190。
             再加设置项就得压行高，或者改窗口尺寸。 -->
        <StackPanel Grid.Row="1" Margin="0,4,0,0">

            <!-- 外观 / 主题 -->
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="外观" Style="{StaticResource RowLabel}" />
                    <TextBlock x:Name="ThemeHint" Style="{StaticResource RowHint}" Text="跟随系统" />
                </StackPanel>

                <Border Grid.Column="1"
                        VerticalAlignment="Center"
                        CornerRadius="7"
                        Padding="2"
                        Background="{DynamicResource SurfaceInset}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeFollowSystem"
                                     GroupName="ThemeSegment"
                                     Style="{StaticResource SegmentButton}"
                                     Content="跟随系统"
                                     Checked="Theme_Checked" />
                        <RadioButton x:Name="ThemeLight"
                                     GroupName="ThemeSegment"
                                     Style="{StaticResource SegmentButton}"
                                     Content="浅色"
                                     Checked="Theme_Checked" />
                        <RadioButton x:Name="ThemeDark"
                                     GroupName="ThemeSegment"
                                     Style="{StaticResource SegmentButton}"
                                     Content="深色"
                                     Checked="Theme_Checked" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource RowSeparator}" />

            <!-- 全局快捷键 -->
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="唤出快捷键" Style="{StaticResource RowLabel}" />
                    <!-- 这行副标题也兼作录音/报错提示，文字会被代码改写 -->
                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource RowHint}" Text="在任何窗口按下都能唤出面板" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border x:Name="HotkeyPill"
                            Height="22"
                            MinWidth="92"
                            CornerRadius="6"
                            Padding="8,0"
                            Background="{DynamicResource SurfaceInset}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1"
                            Cursor="Hand"
                            ToolTip="点击直接录制新的组合键"
                            MouseLeftButtonUp="HotkeyPill_Click">
                        <TextBlock x:Name="HotkeyText"
                                   Text="Ctrl + Shift + A"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextPrimary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <Button x:Name="ChangeHotkeyButton"
                            Style="{StaticResource SmallButton}"
                            Content="更改"
                            Margin="6,0,0,0"
                            Click="ChangeHotkey_Click" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource RowSeparator}" />

            <!-- 开机自启 -->
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="开机自启" Style="{StaticResource RowLabel}" />
                    <!-- 出错时这行会变成红字，说明为什么没开成 -->
                    <TextBlock x:Name="StartupHint"
                               Style="{StaticResource RowHint}"
                               Text="登录 Windows 后自动在托盘待命" />
                </StackPanel>

                <ToggleButton x:Name="LaunchAtStartupSwitch"
                              Grid.Column="1"
                              Style="{StaticResource Switch}"
                              VerticalAlignment="Center"
                              ToolTip="登录后自动启动 WidgetNest（只进托盘）"
                              Click="LaunchAtStartupSwitch_Click" />
            </Grid>

            <Border Style="{StaticResource RowSeparator}" />

            <!-- 图标名称 -->
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="显示图标名称" Style="{StaticResource RowLabel}" />
                    <TextBlock Style="{StaticResource RowHint}" Text="只显示图标，更清爽" />
                </StackPanel>

                <ToggleButton x:Name="ShowIconLabelSwitch"
                              Grid.Column="1"
                              Style="{StaticResource Switch}"
                              VerticalAlignment="Center"
                              ToolTip="隐藏后图标下面不再显示文字"
                              Click="ShowIconLabelSwitch_Click" />
            </Grid>

            <Border Style="{StaticResource RowSeparator}" />

            <!-- 页码 -->
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="显示页码" Style="{StaticResource RowLabel}" />
                    <TextBlock Style="{StaticResource RowHint}" Text="多页时在底部显示「2/3」" />
                </StackPanel>

                <ToggleButton x:Name="ShowPageSwitch"
                              Grid.Column="1"
                              Style="{StaticResource Switch}"
                              VerticalAlignment="Center"
                              ToolTip="隐藏后底部不再显示页码"
                              Click="ShowPageSwitch_Click" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
